#include <iostream>
#include <vector>
using namespace std;

int migratoryBirds(vector<int> arr) {
    int count[6] = {0};

    // Count each bird
    for (int bird : arr) {
        count[bird]++;
    }

    int answer = 1;
    int maxCount = count[1];

    // Find the bird with maximum count
    for (int i = 2; i <= 5; i++) {
        if (count[i] > maxCount) {
            maxCount = count[i];
            answer = i;
        }
    }

    return answer;
}

