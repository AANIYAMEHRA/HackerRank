    int n;
    cout<<"Enter the total number of Birds: ";
    cin >> n;

    vector<int> arr(n);

    cout<<"Enter the Bird's ID: "<<endl;
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    cout<<endl;

    cout <<"Frequency of bird is more: "<< migratoryBirds(arr);

    return 0;
}
