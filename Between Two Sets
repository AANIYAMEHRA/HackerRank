#include <iostream>
#include <vector>
using namespace std;

int getTotalX(vector<int> a, vector<int> b) {
    int count = 0;

    // Check possible numbers from 1 to 100
    for (int x = 1; x <= 100; x++) {
        bool valid = true;

        // Condition 1:
        // Every element of a must be a factor of x
        for (int i = 0; i < a.size(); i++) {
            if (x % a[i] != 0) {
                valid = false;
                break;
            }
        }

        // Condition 2:
        // x must be a factor of every element of b
        if (valid) {
            for (int i = 0; i < b.size(); i++) {
                if (b[i] % x != 0) {
                    valid = false;
                    break;
                }
            }
        }

        // If both conditions are satisfied
        if (valid) {
            count++;
        }
    }

    return count;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<int> a(n);
    vector<int> b(m);

    // Input first array
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // Input second array
    for (int i = 0; i < m; i++) {
        cin >> b[i];
    }

    // Call the function
    int result = getTotalX(a, b);

    cout << result << endl;

    return 0;
}
