#include <iostream>
#include <vector>
using namespace std;

vector<int> gradingStudents(vector<int> grades) {

    for (int i = 0; i < grades.size(); i++) {


        // If grade is less than 38, don't round
        if (grades[i] < 38) {
            continue;
        }


        // Find next multiple of 5
        int nextMultiple = ((grades[i] / 5) + 1) * 5;


        // If difference is less than 3, round up
        if (nextMultiple - grades[i] < 3) {
            grades[i] = nextMultiple;
        }
    }

    return grades;
}

int main() {

    int n;
    cout<<"Enter the number of students: ";
    cin >> n;

    vector<int> grades(n);

    cout<<"Enter the grades: "<<endl;
    for (int i = 0; i < n; i++) {
        cin >> grades[i];
    }
    cout<<endl;

    vector<int> result = gradingStudents(grades);

    cout<<"Final grades: "<<endl;
    for (int grade : result) {
        cout << grade << endl;
    }

    return 0;
}
